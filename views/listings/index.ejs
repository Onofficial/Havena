<% layout("/layouts/boilerplate") %>

<body>

    <section class="hero-section">

        <div class="hero-content">

            <p class="hero-eyebrow">
                DISCOVER YOUR HAVEN
            </p>

            <h1>
                Find Your Next <br> Escape
            </h1>

            <p class="hero-description">
                Beautiful stays, memorable places, and a little
                somewhere to call your own.
            </p>

        </div>
        <div class="hero-quote">
        <span>Where</span>
        <span>The Days</span>
        <span>Slow Down</span>

        <div class="quote-line"></div>
    </div>

    </section>


    <div class="listing-grid">

        <% for (let listing of allListings) { %>

            <div class="card">

                <img
                    src="<%= listing.image %>"
                    class="card-img-top"
                    alt="<%= listing.title %>"
                >

                <div class="card-body">

                    <a
                        class="card-title"
                        href="/listings/<%= listing._id %>"
                    >
                        <%= listing.title %>
                    </a>

                    <p class="card-description">
                        <%= listing.description %>
                    </p>

                    <p class="card-price">
                        &#8377;<%= listing.price
                            ? listing.price.toLocaleString("en-IN")
                            : "Not specified"
                        %>

                        <span>per night</span>
                    </p>

                </div>

            </div>

        <% } %>

    </div>

</body>

