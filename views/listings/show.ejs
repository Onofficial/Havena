<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= listing.title %> | Havena</title>
</head>
<body>
    <h1><%= listing.title %></h1>
    <img src="<%= listing.image %>" alt="<%= listing.title %>" width="400">

    <p><%= listing.description %></p>
    <p><strong>Price:</strong> &#8377;<%= listing.price.toLocaleString("en-IN") %> per night</p>
    <p><strong>Location:</strong> <%= listing.location %>, <%= listing.country %></p>

    <a href="/listings">Back to all listings</a>
    <a href="/listings/<%= listing._id %>/edit">Edit</a>
</body>
</html>
