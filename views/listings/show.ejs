<% layout("/layouts/boilerplate")%>
<body>
    <main class="new-listing-page px-3 px-md-4 py-4">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-5">
                <div class="card show-page-card">
                    <img src="<%= listing.image %>" class="card-img-top show-img" alt="<%= listing.title %>">
                </div>

                <div class="mt-4 show-page-content">
                    <p class="show-page-label">Property details</p>
                    <h1 class="new-listing-title mb-3"><%= listing.title %></h1>
                    <p class="mb-3"><%= listing.description %></p>
                    <p><strong>Price:</strong> &#8377;<%= listing.price.toLocaleString("en-IN") %> per night</p>
                    <p><strong>Location:</strong> <%= listing.location %>, <%= listing.country %></p>

                    <div class="show-page-actions">
                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark">Edit</a>
                        <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="d-inline">
                            <button class="btn btn-danger">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>

