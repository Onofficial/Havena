<% layout("/layouts/boilerplate")%>
<body>
    <main>
        <p>Havena</p>
        <h1>Create a new stay</h1>
        <p>Share the details that help travellers picture their next escape.</p>

        <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">
            <div>
                <div>
                    <label for="title">Listing title</label>
                    <input id="title" name="listing[title]" type="text"
                    value="<%= listing.title %>" placeholder="e.g. Seaside cottage with sunset views" required autofocus>
                </div>

                <div>
                    <label for="description">Description</label>
                    <textarea id="description" value="<%= listing.description %>"  name="listing[description]"  placeholder="Tell guests what makes this place special..." required></textarea>
                </div>

                <div>
                    <label for="image">Image URL <span aria-hidden="true">(optional)</span></label>
                    <input id="image" value="<%= listing.image %>" name="listing[image]" type="url" placeholder="https://images.example.com/your-stay.jpg">
                    <p>Use a direct link to a photo of your listing.</p>
                </div>

                <div>
                    <label for="price">Price per night (₹)</label>
                    <input id="price" value="<%= listing.price %>" name="listing[price]" type="number" min="0" step="1" placeholder="2500" required>
                </div>

                <div>
                    <label for="location">Location</label>
                    <input id="location" value="<%= listing.location %>" name="listing[location]" type="text" placeholder="Goa" required>
                </div>

                <div>
                    <label for="country">Country</label>
                    <input id="country" value="<%= listing.country %>" name="listing[country]" type="text" placeholder="India" required>
                </div>
            </div>

            <div>
                <a href="/listings">Cancel</a>
                <button type="submit">edit it</button>
            </div>
        </form>
    </main>
</body>

