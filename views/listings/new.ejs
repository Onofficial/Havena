<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>havena | new Listing</title>
</head>
<body>
    <main>
        <p>Havena</p>
        <h1>Create a new stay</h1>
        <p>Share the details that help travellers picture their next escape.</p>

        <form method="POST" action="/listings">
            <div>
                <div>
                    <label for="title">Listing title</label>
                    <input id="title" name="listing[title]" type="text" placeholder="e.g. Seaside cottage with sunset views" required autofocus>
                </div>

                <div>
                    <label for="description">Description</label>
                    <textarea id="description" name="listing[description]" placeholder="Tell guests what makes this place special..." required></textarea>
                </div>

                <div>
                    <label for="image">Image URL <span aria-hidden="true">(optional)</span></label>
                    <input id="image" name="listing[image]" type="url" placeholder="https://images.example.com/your-stay.jpg">
                    <p>Use a direct link to a photo of your listing.</p>
                </div>

                <div>
                    <label for="price">Price per night (₹)</label>
                    <input id="price" name="listing[price]" type="number" min="0" step="1" placeholder="2500" required>
                </div>

                <div>
                    <label for="location">Location</label>
                    <input id="location" name="listing[location]" type="text" placeholder="Goa" required>
                </div>

                <div>
                    <label for="country">Country</label>
                    <input id="country" name="listing[country]" type="text" placeholder="India" required>
                </div>
            </div>

            <div>
                <a href="/listings">Cancel</a>
                <button type="submit">Publish listing</button>
            </div>
        </form>
    </main>
</body>
</html>
